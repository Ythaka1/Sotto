{
  "//": "Compiles the pure lib modules to ESM so node --test can run them against the code that ships, rather than a hand written copy.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".testbuild",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "files": ["lib/room.ts", "lib/severity.ts", "lib/email.ts", "lib/groq.ts"]
}
