# Sotto. Copy to .env.local for development, or set these in the Vercel project.
#
# Every one of these is server side. None is prefixed NEXT_PUBLIC_ except the
# site URL, and test/secrets.mjs scans the built client bundle to prove it.
#
# The app runs without all of them. Missing Groq means every verdict comes from
# the local heuristic. Missing Supabase means nothing is stored. Missing Resend
# means no email is sent. In all three cases the guest sees exactly the same
# flow, because there is no error state in the guest UI.

# Groq. One JSON mode call per guest, which keeps this inside the free tier.
GROQ_API_KEY=

# Supabase. The service role key, never the anon key: writes go through the
# server route and bypass RLS, and the table has no policies at all.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. One email per guest, no digest and no batching.
RESEND_API_KEY=
MANAGER_EMAIL=
SOTTO_FROM_EMAIL="Sotto <no-reply@yourdomain.com>"
# Nothing in this product ever contacts the guest, so replies go nowhere.
SOTTO_REPLY_TO=no-reply@yourdomain.com

# The property's own clock, so the checkout time in the email reads the way the
# manager reads it. An IANA name, for example Europe/London.
PROPERTY_TIME_ZONE=Europe/London

# Used by the QR sheet to print codes that point at the deployed app.
NEXT_PUBLIC_SITE_URL=
